SIGNUP_CODE=troque-este-codigo
# Opcional: chave do app pra quem não colocar a própria (uma das duas)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AI_DAILY_LIMIT=60

# Apoio por PIX (sem PIX_KEY o app não mostra o apoio). Prefira chave aleatória.
# PIX_KEY=123e4567-e89b-12d3-a456-426614174000
# PIX_NAME=Seu Nome
# PIX_CITY=Sua Cidade

# IA do app (padrão) e notificações
# GEMINI_API_KEY=AIza...
# VAPID_PUBLIC_KEY=...   (gere com: bun -e 'import {generateVapid} from "./server/push"; console.log(await generateVapid())')
# VAPID_PRIVATE_KEY='{"kty":"EC",...}'
