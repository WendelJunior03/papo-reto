{
  "name": "papo-reto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA para aprender ingl\u00eas pelo m\u00e9todo natural: frases do dia a dia do jeito que os nativos falam.",
  "scripts": {
    "dev": "bun --hot scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "preview": "bun scripts/preview.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "bun test",
    "audio": "bun scripts/audio.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@google/genai": "^3.6.1",
    "openai": "^7.60.0",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.7"
  }
}
